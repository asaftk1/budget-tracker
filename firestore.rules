rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // To drop the verified-email requirement, change the body to: return true;
    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    // Existing document belongs to the signed-in, verified user.
    function ownsExisting() {
      return request.auth != null
        && isVerified()
        && request.auth.uid == resource.data.uid;
    }

    // New document is created for the signed-in, verified user.
    function createsOwn() {
      return request.auth != null
        && isVerified()
        && request.resource.data.uid == request.auth.uid;
    }

    // Update by the owner, and the owner field cannot be reassigned.
    function updatesOwn() {
      return ownsExisting()
        && request.resource.data.uid == resource.data.uid;
    }

    // Transaction amounts are stored as integer agorot (1 ILS = 100 agorot):
    // a positive integer, at most 10,000,000.00 ILS. Every create and every update must
    // leave the document with a valid amountAgorot.
    function validAgorot() {
      return request.resource.data.amountAgorot is int
        && request.resource.data.amountAgorot >= 1
        && request.resource.data.amountAgorot <= 1000000000;
    }

    match /transactions/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwn() && validAgorot();
      allow update: if updatesOwn() && validAgorot();
    }

    match /categories/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if updatesOwn();
    }

    // Document IDs are "<uid>_<merchant>". Create requires the ID to start with the
    // caller's uid so nobody can pre-create (squat) another user's document IDs.
    match /merchantCategories/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwn() && docId.matches(request.auth.uid + '_.*');
      allow update: if updatesOwn();
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
